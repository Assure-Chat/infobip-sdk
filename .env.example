# Copy to .env.local (gitignored) and fill in. Never commit real values.

# Your account's API host, from https://portal.infobip.com — each account has its own.
INFOBIP_BASE_URL=https://xxxxx.api.infobip.com

# An API key from https://portal.infobip.com/settings/accounts/api-keys
# Sent as `Authorization: App <key>`.
INFOBIP_API_KEY=

# The registered RCS *sender name*, not the RBM agent id. See the README note on
# EC_UNKNOWN_USER — the wrong one here is accepted and then rejected by the operator.
INFOBIP_RCS_SENDER=Assure

# The handset the integration test messages, in E.164.
INFOBIP_TEST_MSISDN=+441134960001

# Shared secret you attach to the webhook callback URL you register, checked by
# @assure/infobip-webhooks. Only needed when running the webhook listener.
INFOBIP_WEBHOOK_SECRET=
